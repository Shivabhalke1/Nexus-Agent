# Backend Environment Configuration
ENVIRONMENT=development
APP_NAME=NEXUS-Demo-Portal-Backend
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database (PostgreSQL URL; fallback to sqlite for automated tests)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nexus_demo_portal
# Example SQLite fallback for local test runs:
# DATABASE_URL=sqlite:///./nexus_demo.db

# Security & Authentication
SECRET_KEY=dev-secret-key-nexus-observe-2026-cicada-hackathon-security
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Observability & Metrics
SERVICE_NAME=nexus-demo-backend
LOG_LEVEL=INFO
ENABLE_METRICS=true

# Controlled Failure Simulator
ENABLE_FAILURE_SIMULATOR=true
SIMULATION_AUTH_KEY=dev-nexus-simulation-key-2026
MAX_SIMULATION_DURATION_SECONDS=300

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
